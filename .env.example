# Server-only. Never prefix these with NEXT_PUBLIC_.
# Copy to .env.local and replace placeholders with values from
# Supabase Dashboard → Project Settings → Database → Connect.

# Next.js / Prisma Client runtime (transaction pooler, port 6543)
DATABASE_URL="postgresql://USER.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI migrations (session pooler, port 5432)
DIRECT_URL="postgresql://USER.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase Auth client configuration (browser and server)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-publishable-key"

# Canonical site URL for OAuth callbacks and absolute redirects
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
