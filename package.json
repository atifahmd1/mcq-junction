{
  "name": "mcq-junction",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "preflight": "node scripts/release-preflight.mjs",
    "dev:admin": "node scripts/dev/create-admin.mjs",
    "test:unit": "node --test tests/auth-validation.test.mjs tests/scoring.test.mjs tests/security-headers.test.mjs tests/admin-service.test.mjs tests/admin-workflows.test.mjs tests/security-isolation.test.mjs tests/tls-certificate-verification.test.mjs tests/concept-modal.test.mjs tests/question-evaluation.test.mjs tests/question-validation.test.mjs tests/import-export.test.mjs tests/exam-domain.test.mjs",
    "test:security": "node --test tests/security-isolation.test.mjs tests/tls-certificate-verification.test.mjs",
    "test:tls": "node --test tests/tls-certificate-verification.test.mjs",
    "test:browser": "node tests/browser-e2e.test.mjs",
    "test:concept": "node tests/concept-modal-browser.test.mjs",
    "test:admin": "node tests/phase7-admin-workflows.test.mjs",
    "test:e2e": "node --test tests/e2e-workflows.test.mjs",
    "test:db": "node --test tests/database.test.mjs tests/e2e-workflows.test.mjs tests/passage-database.test.mjs tests/exam-database.test.mjs tests/scheduler-finalization.test.mjs",
    "test": "npm run test:unit && npm run test:db",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:bootstrap": "node scripts/bootstrap-test-db.mjs",
    "db:test:down": "docker compose -f docker-compose.test.yml down -v",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "dotenv": "^16.4.7",
    "next": "16.4.0",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "braces": ">=3.0.3"
  }
}
